# PROPOSED CONFIGURATION SHAPE — NOT YET WIRED
#
# Milestone 0 is approved. It must reconcile these names
# with the selected Next.js/Auth.js/storage/mail libraries and then make startup
# validate them. Do not copy real credentials into this file.

# Application
APP_ENV=local
APP_URL=http://localhost:3000
CONTENT_ORIGIN=http://localhost:3001
PUBLISHING_ENABLED=false
COMMENTS_ENABLED=false

# PostgreSQL
DATABASE_URL=postgresql://callysto:callysto@localhost:5432/callysto

# Sessions and OAuth
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://sandbox.orcid.org
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_HMAC_KEY=
EMAIL_LOOKUP_HMAC_KEY_VERSION=1

# Private Cloudflare R2 (use a local fake during ordinary development/tests)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=callysto-local
R2_ENDPOINT=
R2_RECOVERY_BUCKET_NAME=callysto-local-recovery
R2_RECOVERY_ACCESS_KEY_ID=
R2_RECOVERY_SECRET_ACCESS_KEY=
R2_RECOVERY_ENDPOINT=

# Content capability signing (server/gateway only)
CONTENT_CAPABILITY_SECRET=
CONTENT_PUBLIC_TTL_SECONDS=60
CONTENT_PREVIEW_TTL_SECONDS=300

# Renderer policy
RENDERER_VERSION=dev
RENDER_POLICY_VERSION=dev
NORMALIZATION_VERSION=dev
MANIFEST_SCHEMA_VERSION=dev
RENDER_JOB_LEASE_SECONDS=120
RENDER_MAX_ATTEMPTS=2
RENDER_MAX_SOURCE_BYTES=26214400
RENDER_MAX_DERIVED_BYTES=52428800

# Transactional notifications (local sink by default)
NOTIFICATION_DISPATCH_MODE=dedicated
NOTIFICATION_DISPATCH_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5
MAIL_TRANSPORT=local
MAIL_FROM=callysto@localhost
MAIL_PROVIDER_TOKEN=

# Observability
LOG_LEVEL=info
ERROR_REPORTING_DSN=
