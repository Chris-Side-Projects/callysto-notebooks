{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callysto.invalid/contracts/render-manifest-v0.schema.json",
  "title": "Callysto proposed render manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version_id",
    "accepted_original_sha256",
    "nbformat_major",
    "nbformat_minor",
    "kernel_name",
    "kernel_language",
    "contract",
    "normalization_actions",
    "cells"
  ],
  "properties": {
    "schema_version": { "const": "callysto.render-manifest.v0" },
    "version_id": { "type": "string", "minLength": 1 },
    "accepted_original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nbformat_major": { "type": "integer", "minimum": 1 },
    "nbformat_minor": { "type": "integer", "minimum": 0 },
    "kernel_name": { "type": ["string", "null"], "maxLength": 200 },
    "kernel_language": { "type": ["string", "null"], "maxLength": 200 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notebook_execution",
        "network_access",
        "application_html_injection",
        "markdown",
        "active_complex_output",
        "cell_id_algorithm"
      ],
      "properties": {
        "notebook_execution": { "const": "forbidden" },
        "network_access": { "const": "forbidden" },
        "application_html_injection": { "const": "forbidden" },
        "markdown": { "const": "strict_subset_raw_html_disabled" },
        "active_complex_output": { "const": "placeholder_in_m0" },
        "cell_id_algorithm": { "const": "callysto-cell-id-v1" }
      }
    },
    "normalization_actions": { "type": "array", "items": { "type": "object" } },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ordinal",
          "cell_type",
          "cell_source_sha256",
          "source",
          "outputs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "ordinal": { "type": "integer", "minimum": 0 },
          "cell_type": { "enum": ["code", "markdown", "raw"] },
          "cell_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "object",
            "required": ["presentation", "text"],
            "properties": {
              "presentation": { "enum": ["escaped_text", "strict_markdown"] },
              "text": { "type": "string" },
              "raw_html_allowed": { "const": false }
            }
          },
          "outputs": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
